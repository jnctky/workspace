# ============================================================
# OpenAI 兼容适配层配置（复制为 .env 后填写）
# ============================================================

# --- 上游模型服务（任意 OpenAI 兼容接口）---
# MiniMax 国内站：https://api.minimaxi.com/v1
# MiniMax 国际站：https://api.minimax.io/v1
# DeepSeek：      https://api.deepseek.com/v1
# 本地 Ollama：   http://127.0.0.1:11434/v1
# 本地 LM Studio：http://127.0.0.1:1234/v1
OPENAI_BASE_URL=https://api.minimaxi.com/v1

# 你的 MiniMax Token（也支持在 Workspace 的 Add Copilot → Headers 里用
# X-Upstream-Key 按会话覆盖，不必写进文件）
OPENAI_API_KEY=

# 默认模型
OPENAI_MODEL=MiniMax-M3

# 模型下拉里可选的清单（逗号分隔，第一项建议与上面一致）
OPENAI_MODELS=MiniMax-M3,MiniMax-M3.1-Flash,MiniMax-M2.7,MiniMax-M2.7-highspeed,MiniMax-M2.5,MiniMax-M2.1,MiniMax-M2

# 采样参数
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096
OPENAI_TOP_P=1.0

# --- 适配层自身 ---
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=7777

# --- 上下文预算（字符数，防止把整个仪表盘塞爆上下文）---
CONTEXT_MAX_CHARS=40000
WIDGET_MAX_CHARS=6000
ATTACHMENT_MAX_CHARS=12000

# 上游超时（秒）。推理型模型首字可能较慢，别设太小
UPSTREAM_TIMEOUT=300

# 思考过程（<think> 块）怎么显示：status=折叠成推理步骤（推荐）/ hide=丢弃 / inline=跟着答案一起显示
REASONING_MODE=status
# 推理步骤每条消息的最大字符数（越小越细碎）
REASONING_CHUNK_CHARS=320

# 每个问题最多允许几次 get_widget_data 取数（防止模型反复调用）
MAX_TOOL_ROUNDS=3

# 上游走代理时填写（国际站需要，国内站一般留空）
# UPSTREAM_PROXY=http://127.0.0.1:10808

# --- 在 Workspace 里显示的身份 ---
# 注意：AGENT_ID 一旦在 Workspace 里添加过，改动后需要在
# LIBRARY → AI → Agents 里删掉旧条目再重新添加，否则会提示 ID 冲突。
AGENT_ID=openai-compatible-copilot
AGENT_NAME=MiniMax Copilot
AGENT_DESCRIPTION=通过 OpenAI 兼容适配层接入的 MiniMax 模型，可读取当前仪表盘 widget 数据。

# --- 可选能力（默认关闭，因为适配层不执行工具/不生成 UI）---
FEATURE_GLOBAL_SEARCH=false
FEATURE_GENERATIVE_UI=false
FEATURE_MCP_TOOLS=false
